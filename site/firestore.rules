rules_version = '2';

// Правила доступу «Час у дорозі».
//   Водій    — бачить і змінює лише свої зміни та свій профіль.
//   Керівник — (users/{uid}.role == 'manager') бачить усіх водіїв і всі зміни, лише читання.
// Роль 'manager' ставиться вручну в Firebase Console; сам користувач її змінити не може.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isManager() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'manager';
    }

    function validName(n) {
      return n is string && n.size() >= 1 && n.size() <= 60;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isManager());

      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'role', 'createdAt'])
        && validName(request.resource.data.name)
        && request.resource.data.email is string
        && request.resource.data.role == 'driver'
        && request.resource.data.createdAt is number;

      // Можна змінити лише ім'я
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && validName(request.resource.data.name);
    }

    function validShift(d) {
      return d.keys().hasOnly(['uid', 'driverName', 'start', 'end', 'breaks', 'note', 'updatedAt'])
        && d.uid == request.auth.uid
        && d.driverName is string && d.driverName.size() <= 60
        && d.start is number
        && (d.end == null || (d.end is number && d.end >= d.start))
        && d.breaks is list && d.breaks.size() <= 50
        && d.note is string && d.note.size() <= 200
        && d.updatedAt is number;
    }

    match /shifts/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isManager());
      allow create: if signedIn() && validShift(request.resource.data);
      allow update: if signedIn() && resource.data.uid == request.auth.uid
        && validShift(request.resource.data);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
  }
}
