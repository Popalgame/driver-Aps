rules_version = '2';

// Правила доступу «Час у дорозі».
//   pending  — увійшов, але ще не підтверджений керівником: нічого не записує.
//   driver   — бачить і змінює лише свої зміни та своє ім'я.
//   disabled — доступ закрито керівником: нічого не записує.
//   manager  — бачить усіх водіїв і всі зміни (лише читання), додає водіїв,
//              підтверджує й закриває доступ.
// Реєстрації немає. Першого керівника призначають вручну в Firebase Console.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isManager() {
      return signedIn() && myRole() == 'manager';
    }

    function isActive() {
      return signedIn() && myRole() in ['driver', 'manager'];
    }

    function validName(n) {
      return n is string && n.size() >= 1 && n.size() <= 60;
    }

    function validProfile(d) {
      return d.keys().hasOnly(['name', 'email', 'role', 'createdAt'])
        && validName(d.name)
        && d.email is string && d.email.size() <= 200
        && d.createdAt is number;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isManager());

      // Перший вхід: профіль створюється сам, але чекає підтвердження
      allow create: if signedIn() && request.auth.uid == uid
        && validProfile(request.resource.data)
        && request.resource.data.role == 'pending';

      // Керівник додає водія
      allow create: if isManager() && request.auth.uid != uid
        && validProfile(request.resource.data)
        && request.resource.data.role == 'driver';

      // Свій профіль: лише ім'я
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && validName(request.resource.data.name);

      // Керівник: підтвердити, закрити / відновити доступ, перейменувати.
      // Не себе й не інших керівників; керівником нікого не робить.
      allow update: if isManager() && request.auth.uid != uid
        && resource.data.role != 'manager'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'role'])
        && request.resource.data.role in ['driver', 'disabled']
        && validName(request.resource.data.name);
    }

    function validShift(d) {
      return d.keys().hasOnly(['uid', 'driverName', 'start', 'end', 'breaks', 'note', 'updatedAt'])
        && d.uid == request.auth.uid
        && d.driverName is string && d.driverName.size() <= 60
        && d.start is number
        && (d.end == null || (d.end is number && d.end >= d.start))
        && d.breaks is list && d.breaks.size() <= 50
        && d.note is string && d.note.size() <= 200
        && d.updatedAt is number;
    }

    match /shifts/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isManager());
      allow create: if isActive() && validShift(request.resource.data);
      allow update: if isActive() && resource.data.uid == request.auth.uid
        && validShift(request.resource.data);
      allow delete: if isActive() && resource.data.uid == request.auth.uid;
    }
  }
}
