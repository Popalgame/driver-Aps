rules_version = '2';

// Правила доступу «Час у дорозі».
//   pending  — увійшов, але ще не підтверджений керівником: нічого не записує.
//   driver   — бачить і змінює лише свої зміни та своє ім'я.
//   disabled — доступ закрито керівником: нічого не записує.
//   hr       — кадри: бачить лише календар і імена людей своїх проєктів
//              (без змін, кілометражу й профілів водіїв). У профілі kind: 'hr'.
//   manager  — бачить усіх водіїв і всі зміни (лише читання), додає водіїв і кадри,
//              підтверджує й закриває доступ.
// Реєстрації немає. Першого керівника призначають вручну в Firebase Console.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isManager() {
      return signedIn() && myRole() == 'manager';
    }

    function isActive() {
      return signedIn() && myRole() in ['driver', 'manager'];
    }

    // Хто працює з календарем проєктів
    function isTeam() {
      return signedIn() && myRole() in ['driver', 'manager', 'hr'];
    }

    function validName(n) {
      return n is string && n.size() >= 1 && n.size() <= 60;
    }

    function validProfile(d) {
      return d.keys().hasOnly(['name', 'email', 'role', 'kind', 'createdAt'])
        && validName(d.name)
        && (!('kind' in d) || d.kind == 'hr')
        && d.email is string && d.email.size() <= 200
        && d.createdAt is number;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isManager());

      // Перший вхід: профіль створюється сам, але чекає підтвердження
      allow create: if signedIn() && request.auth.uid == uid
        && validProfile(request.resource.data)
        && request.resource.data.role == 'pending';

      // Керівник додає водія або кадровика (у кадровика kind: 'hr')
      allow create: if isManager() && request.auth.uid != uid
        && validProfile(request.resource.data)
        && ((request.resource.data.role == 'driver' && !('kind' in request.resource.data))
          || (request.resource.data.role == 'hr' && request.resource.data.get('kind', '') == 'hr'));

      // Свій профіль: лише ім'я
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && validName(request.resource.data.name);

      // Керівник: підтвердити, закрити / відновити доступ, перейменувати.
      // Не себе й не інших керівників; керівником нікого не робить.
      allow update: if isManager() && request.auth.uid != uid
        && resource.data.role != 'manager'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'role'])
        && request.resource.data.role in ['driver', 'disabled', 'hr']
        && (request.resource.data.role != 'hr' || resource.data.get('kind', '') == 'hr')
        && (request.resource.data.role != 'driver' || resource.data.get('kind', '') != 'hr')
        && validName(request.resource.data.name);
    }

    function validShift(d) {
      return d.keys().hasOnly(['uid', 'driverName', 'start', 'end', 'breaks', 'note', 'updatedAt'])
        && d.uid == request.auth.uid
        && d.driverName is string && d.driverName.size() <= 60
        && d.start is number
        && (d.end == null || (d.end is number && d.end >= d.start))
        && d.breaks is list && d.breaks.size() <= 50
        && d.note is string && d.note.size() <= 200
        && d.updatedAt is number;
    }

    // Кілометраж (показник одометра зранку) і заправки (для заправки достатньо дати)
    function validMileage(d) {
      return d.keys().hasOnly(['uid', 'type', 'at', 'km', 'liters', 'amount', 'note', 'updatedAt'])
        && d.uid == request.auth.uid
        && d.type in ['odo', 'fuel']
        && d.at is number
        && (d.km == null || (d.km is number && d.km >= 0 && d.km < 10000000))
        && (d.liters == null || (d.liters is number && d.liters > 0 && d.liters < 2000))
        && (d.amount == null || (d.amount is number && d.amount >= 0 && d.amount < 1000000))
        && (d.type != 'odo' || d.km is number)
        && d.note is string && d.note.size() <= 200
        && d.updatedAt is number;
    }

    match /mileage/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isManager());
      allow create: if isActive() && validMileage(request.resource.data);
      allow update: if isActive() && resource.data.uid == request.auth.uid
        && validMileage(request.resource.data);
      allow delete: if isActive() && resource.data.uid == request.auth.uid;
    }

    match /shifts/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isManager());
      allow create: if isActive() && validShift(request.resource.data);
      allow update: if isActive() && resource.data.uid == request.auth.uid
        && validShift(request.resource.data);
      allow delete: if isActive() && resource.data.uid == request.auth.uid;
    }

    // ---------- Проєкти й календар ----------
    // Проєкт створює керівник і додає до нього водіїв. Водій бачить лише свої проєкти
    // і події календаря цих проєктів; події додає, змінює й видаляє будь-хто з проєкту.
    // Учасник проєкту: водій (members) або кадровик (hr)
    function inProject(p) {
      return request.auth.uid in p.members || request.auth.uid in p.get('hr', []);
    }

    function isMember(pid) {
      return isTeam() && inProject(get(/databases/$(database)/documents/projects/$(pid)).data);
    }

    function validProject(d) {
      return d.keys().hasOnly(['name', 'members', 'hr', 'names', 'color', 'createdAt', 'updatedAt'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 40
        && d.members is list && d.members.size() <= 50
        && (!('hr' in d) || (d.hr is list && d.hr.size() <= 20))
        && d.names is map
        && d.color is int && d.color >= 0 && d.color < 12
        && d.createdAt is number && d.updatedAt is number;
    }

    function validEvent(d) {
      return d.keys().hasOnly(['project', 'date', 'time', 'title', 'people', 'note', 'by', 'byName', 'editedBy', 'editedByName', 'editedAt',
          'need', 'status', 'driver', 'driverName', 'takenAt', 'startedAt', 'doneAt', 'createdAt', 'updatedAt'])
        && d.project is string
        && d.date is string && d.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && d.time is string && (d.time == '' || d.time.matches('[0-9]{2}:[0-9]{2}'))
        && d.title is string && d.title.size() >= 1 && d.title.size() <= 80
        && (d.people == null || (d.people is int && d.people >= 1 && d.people <= 999))
        && d.note is string && d.note.size() <= 300
        && d.by is string && d.byName is string && d.byName.size() <= 60
        && (!('editedByName' in d) || (d.editedByName is string && d.editedByName.size() <= 60))
        && (!('need' in d) || d.need is bool)
        && d.get('status', 'open') in ['open', 'taken', 'onway', 'done']
        && (d.get('driver', null) == null || d.driver is string)
        && (!('driverName' in d) || (d.driverName is string && d.driverName.size() <= 60))
        && d.createdAt is number && d.updatedAt is number;
    }

    match /projects/{pid} {
      allow read: if isManager() || (isTeam() && inProject(resource.data));
      allow create, update: if isManager() && validProject(request.resource.data);
      allow delete: if isManager();
    }

    // Завдання (подія, де потрібен водій): Потрібен водій → Взяв → В дорозі → Виконано.
    // Взяти може лише водій і лише вільне завдання; далі кроки робить лише той, хто взяв.
    // Керівник може все (напр., перепризначити).
    function taskChangeOk() {
      let nd = request.resource.data;
      let od = resource.data;
      let me = request.auth.uid;
      return !nd.diff(od).affectedKeys().hasAny(['status', 'driver', 'driverName', 'takenAt', 'startedAt', 'doneAt'])
        || isManager()
        || (myRole() == 'driver' && (
          (od.get('driver', null) == null && nd.get('driver', null) == me && nd.status == 'taken')
          || (od.get('driver', null) == me && nd.get('driver', null) == me && nd.status in ['taken', 'onway', 'done'])
          || (od.get('driver', null) == me && nd.get('driver', null) == null && nd.status == 'open')));
    }

    match /events/{id} {
      allow read: if isManager() || isMember(resource.data.project);
      allow create: if validEvent(request.resource.data)
        && request.resource.data.by == request.auth.uid
        && !('editedBy' in request.resource.data)
        && request.resource.data.get('status', 'open') == 'open'
        && request.resource.data.get('driver', null) == null
        && (isManager() || isMember(request.resource.data.project));
      allow update: if validEvent(request.resource.data)
        && request.resource.data.project == resource.data.project
        && request.resource.data.by == resource.data.by
        && request.resource.data.createdAt == resource.data.createdAt
        && (request.resource.data.get('editedBy', '') == resource.data.get('editedBy', '')
          || request.resource.data.get('editedBy', '') == request.auth.uid)
        && taskChangeOk()
        && (isManager() || isMember(resource.data.project));
      allow delete: if isManager() || isMember(resource.data.project);
    }

    // ---------- Оголошення ----------
    // Керівник пише будь-кому, кадри — лише людям свого проєкту. Отримувачі фіксуються
    // при надсиланні; отримувач може лише поставити свою позначку «Прочитав».
    function validNotice(d) {
      return d.keys().hasOnly(['text', 'by', 'byName', 'to', 'target', 'recipients', 'names', 'important', 'until', 'createdAt', 'read'])
        && d.text is string && d.text.size() >= 1 && d.text.size() <= 500
        && d.by == request.auth.uid
        && d.byName is string && d.byName.size() <= 60
        && d.to in ['all', 'drivers', 'hr', 'project', 'user']
        && (d.target == null || d.target is string)
        && d.recipients is list && d.recipients.size() >= 1 && d.recipients.size() <= 100
        && d.names is map
        && d.important is bool
        && (d.until == null || d.until is number)
        && d.createdAt is number
        && d.read is map && d.read.size() == 0;
    }

    function hrNoticeOk(d) {
      let p = get(/databases/$(database)/documents/projects/$(d.target)).data;
      return myRole() == 'hr' && d.to == 'project' && d.target is string
        && request.auth.uid in p.get('hr', [])
        && d.recipients.hasOnly(p.members.concat(p.get('hr', [])));
    }

    match /notices/{id} {
      allow read: if isManager()
        || (isTeam() && (request.auth.uid in resource.data.recipients || resource.data.by == request.auth.uid));
      allow create: if validNotice(request.resource.data)
        && (isManager() || hrNoticeOk(request.resource.data));
      allow update: if isTeam() && request.auth.uid in resource.data.recipients
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read.diff(resource.data.read).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.read[request.auth.uid] is number;
      allow delete: if isManager() || (isTeam() && resource.data.by == request.auth.uid);
    }
  }
}
